# Required
DISCORD_TOKEN=replace-me

# PostgreSQL / Redis
DATABASE_URL=postgresql+asyncpg://music:music@postgres:5432/music
REDIS_URL=redis://redis:6379/0

# Optional: use a guild ID for instant slash-command sync during development.
DEV_GUILD_ID=
LOG_LEVEL=INFO

# Limits and behaviour
DEFAULT_VOLUME=65
DEFAULT_MAX_QUEUE_SIZE=100
DEFAULT_AUTO_DISCONNECT_TIMEOUT=300
DEFAULT_AUTOPLAY=false
VOICE_CONNECT_TIMEOUT=20
VOICE_RECONNECT_ATTEMPTS=4
SEARCH_RATE_LIMIT=10
PLAY_RATE_LIMIT=20
PLAYLIST_RATE_LIMIT=5
MAX_PLAYLIST_TRACKS=500
SEARCH_CACHE_TTL=120
METADATA_CACHE_TTL=900
FFMPEG_BIN=ffmpeg
